# Managed by Ansible -- do not edit manually.
COMPOSE_FILE={{ (['compose.yml']
  + (['compose.override.bifrost.yml'] if komodo_core_bifrost else []))
  | join(':') }}
TZ={{ komodo_core_tz }}

# Image
KOMODO_IMAGE_TAG={{ komodo_core_image_tag }}

# Network
KOMODO_BIND_IP={{ komodo_core_bind_ip }}
KOMODO_PORT={{ komodo_core_port }}

# Database
KOMODO_DATABASE_USERNAME={{ komodo_core_db_username }}
KOMODO_DATABASE_PASSWORD={{ komodo_core_db_password }}
MONGO_CACHE_SIZE_GB={{ komodo_core_mongo_cache_gb }}

# Core
KOMODO_HOST={{ komodo_core_host }}
KOMODO_TITLE={{ komodo_core_title }}
KOMODO_FIRST_SERVER_NAME={{ komodo_core_first_server_name }}
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_core_admin_password }}
KOMODO_JWT_SECRET={{ komodo_core_jwt_secret }}
KOMODO_WEBHOOK_SECRET={{ komodo_core_webhook_secret }}
KOMODO_MONITORING_INTERVAL={{ komodo_core_monitoring_interval }}
KOMODO_RESOURCE_POLL_INTERVAL={{ komodo_core_resource_poll_interval }}

# Paths
KOMODO_BACKUPS_PATH={{ komodo_core_backups_path }}
KOMODO_SECRETS_FILE={{ komodo_core_deploy_path }}/core.secrets.toml
PERIPHERY_ROOT_DIRECTORY={{ komodo_core_periphery_root }}
