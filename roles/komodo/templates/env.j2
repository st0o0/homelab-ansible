# Managed by Ansible -- do not edit manually.
COMPOSE_FILE=compose.yml
TZ={{ komodo_tz }}

# Image
KOMODO_IMAGE_TAG={{ komodo_image_tag }}

# Network
KOMODO_BIND_IP={{ komodo_bind_ip }}
KOMODO_PORT={{ komodo_port }}

# Database (MongoDB runs on a separate host via the komodo_db role)
KOMODO_DATABASE_ADDRESS={{ komodo_database_address }}
KOMODO_DATABASE_USERNAME={{ komodo_db_username }}
KOMODO_DATABASE_PASSWORD={{ komodo_db_password }}

# Core
KOMODO_HOST={{ komodo_host }}
KOMODO_TITLE={{ komodo_title }}
KOMODO_FIRST_SERVER_NAME={{ komodo_first_server_name }}
KOMODO_INIT_ADMIN_PASSWORD={{ komodo_admin_password }}
KOMODO_JWT_SECRET={{ komodo_jwt_secret }}
KOMODO_WEBHOOK_SECRET={{ komodo_webhook_secret }}
KOMODO_MONITORING_INTERVAL={{ komodo_monitoring_interval }}
KOMODO_RESOURCE_POLL_INTERVAL={{ komodo_resource_poll_interval }}

# Paths
KOMODO_BACKUPS_PATH={{ komodo_backups_path }}
KOMODO_SECRETS_FILE={{ komodo_deploy_path }}/core.secrets.toml
PERIPHERY_ROOT_DIRECTORY={{ komodo_periphery_root }}
