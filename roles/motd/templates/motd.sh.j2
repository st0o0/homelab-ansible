{% raw %}#!/bin/bash
# Managed by Ansible -- do not edit manually.

# ── Catppuccin Mocha palette (true-color) ────────────────────────────
R='\e[0m'
MAUVE='\e[38;2;203;166;247m'
BLUE='\e[38;2;137;180;250m'
GREEN='\e[38;2;166;227;161m'
RED='\e[38;2;243;139;168m'
YELLOW='\e[38;2;249;226;175m'
SUBTEXT='\e[38;2;166;173;200m'
OVERLAY='\e[38;2;108;112;134m'
BOLD='\e[1m'

# ── Data gathering ──────────────────────────────────────────────────
HOSTNAME=$(hostname)
KERNEL=$(uname -r)
OS=$(. /etc/os-release 2>/dev/null && echo "$PRETTY_NAME" || uname -o)

# Uptime — compact, from /proc
UP_SEC=$(cut -d. -f1 /proc/uptime)
UP_D=$((UP_SEC / 86400)); UP_H=$(( (UP_SEC % 86400) / 3600 )); UP_M=$(( (UP_SEC % 3600) / 60 ))
if [ "$UP_D" -gt 0 ]; then UPTIME="${UP_D}d ${UP_H}h"
elif [ "$UP_H" -gt 0 ]; then UPTIME="${UP_H}h ${UP_M}m"
else UPTIME="${UP_M}m"; fi

# CPU
CPU_CORES=$(nproc)
CPU_TEMP=""
[ -f /sys/class/thermal/thermal_zone0/temp ] && CPU_TEMP="$(( $(cat /sys/class/thermal/thermal_zone0/temp) / 1000 ))"

# Load
LOAD_1M=$(cut -d' ' -f1 /proc/loadavg)

# Memory
MEM_PCT=$(free | awk '/^Mem:/{printf "%.0f", $3/$2*100}')
MEM_TOTAL=$(free -h | awk '/^Mem:/{print $2}')

# Disk
DISK_PCT=$(df / | awk 'NR==2{gsub(/%/,""); print $5}')
DISK_USED=$(df -h / | awk 'NR==2{print $3}')
DISK_TOTAL=$(df -h / | awk 'NR==2{print $2}')

# Docker — background (Armbian style: names as comma list)
DOCKER_TMP=$(mktemp)
if command -v docker &>/dev/null; then
    docker ps --format '{{.Names}}' 2>/dev/null | sort | paste -sd, - | sed 's/,/, /g' > "$DOCKER_TMP" &
    DOCKER_PID=$!
fi

# Network — classify from ip addr (instant)
LAN="" WG="" IPV6=""
while IFS= read -r line; do
    iface=$(echo "$line" | awk '{print $NF}')
    addr=$(echo "$line" | awk '{gsub(/\/.*/, "", $2); print $2}')
    if echo "$addr" | grep -qE '^(fd|fe80)'; then
        [ -z "$IPV6" ] && IPV6="$addr"
    elif echo "$iface" | grep -qiE '^wg' || echo "$addr" | grep -qE '^10\.0\.101\.'; then
        WG="${WG:+$WG, }$addr"
    elif echo "$addr" | grep -qE '^172\.(1[6-9]|2[0-9]|3[01])\.'; then
        :
    elif echo "$addr" | grep -qE '^(10\.|192\.168\.)'; then
        LAN="${LAN:+$LAN, }$addr"
    fi
done < <(ip -o addr show 2>/dev/null | grep -v ' lo ' | awk '/inet6? /{print}')

# ── Helpers ─────────────────────────────────────────────────────────
# Armbian-style two-column row: "  Label:  value\tLabel:  value\n"
# Color value green normally, red when over threshold
row() {
    local l1="$1" v1="$2" t1="${3:-}" l2="${4:-}" v2="${5:-}" t2="${6:-}"
    local c1="$GREEN" c2="$GREEN"
    [ -n "$t1" ] && [ "$v1" -ge "$t1" ] 2>/dev/null && c1="$RED"
    [ -n "$t2" ] && [ "$v2" -ge "$t2" ] 2>/dev/null && c2="$RED"
    printf "  ${SUBTEXT}%-14s${R}${c1}%s${R}" "$l1" "$v1"
    if [ -n "$l2" ]; then
        printf "\t${SUBTEXT}%-10s${R}${c2}%s${R}" "$l2" "$v2"
    fi
    printf "\n"
}

hdr() {
    local label="$1" w=55 pre="─── " dashes=""
    local n=$(( w - ${#pre} - ${#label} - 1 ))
    [ "$n" -lt 3 ] && n=3
    printf -v dashes '%*s' "$n" ''; dashes="${dashes// /─}"
    echo -e "${MAUVE}${pre}${label} ${dashes}${R}"
}

# ── Banner ──────────────────────────────────────────────────────────
BANNER=$(figlet -f small "$HOSTNAME" 2>/dev/null || echo " $HOSTNAME")
echo ""
echo -e "${MAUVE}${BOLD}${BANNER}${R}"
echo -e " ${SUBTEXT}${OS} · ${KERNEL}${R}"

# ── Info (Armbian-style label: value pairs) ─────────────────────────
echo ""

# Network
[ -n "$LAN" ]  && printf "  ${SUBTEXT}%-14s${R}${GREEN}%s${R}\n" "IPv4:" "$LAN"
[ -n "$WG" ]   && printf "  ${SUBTEXT}%-14s${R}${GREEN}%s${R}\n" "WireGuard:" "$WG"
[ -n "$IPV6" ] && printf "  ${SUBTEXT}%-14s${R}${GREEN}%s${R}\n" "IPv6:" "$IPV6"

# Containers — wait for background docker
if [ -n "${DOCKER_PID:-}" ]; then
    wait "$DOCKER_PID" 2>/dev/null
    CONTAINER_LIST=$(<"$DOCKER_TMP")
    [ -n "$CONTAINER_LIST" ] && printf "  ${SUBTEXT}%-14s${R}${GREEN}%s${R}\n" "Containers:" "$CONTAINER_LIST"
fi
rm -f "$DOCKER_TMP"

# Performance header
echo ""
hdr "Performance"
echo ""

row "Uptime:" "$UPTIME" "" "Load:" "$LOAD_1M"

CPU_LINE="${CPU_CORES} cores"
[ -n "$CPU_TEMP" ] && CPU_LINE="${CPU_LINE}, ${CPU_TEMP}°C"
row "CPU:" "$CPU_LINE" "" "Memory:" "${MEM_PCT}% of ${MEM_TOTAL}" "85"

row "Disk /:" "${DISK_PCT}% of ${DISK_TOTAL}" "85" "Usage:" "${DISK_USED} / ${DISK_TOTAL}"

# Storage (only if >1 mount)
declare -a ST_N=() ST_P=() ST_U=() ST_T=()
while IFS= read -r line; do
    m=$(echo "$line" | awk '{print $6}')
    p=$(echo "$line" | awk '{gsub(/%/,""); print $5}')
    u=$(echo "$line" | awk '{print $3}')
    t=$(echo "$line" | awk '{print $2}')
    n=$(basename "$m"); [ "$n" = "/" ] && n="root"
    ST_N+=("$n"); ST_P+=("$p"); ST_U+=("$u"); ST_T+=("$t")
done < <(df -h --output=source,size,used,avail,pcent,target 2>/dev/null \
    | awk 'NR>1 && $1 !~ /^(tmpfs|overlay|devtmpfs|udev|shm|none)/' \
    | grep -v '/boot\|/snap\|/run\|/sys\|/proc\|/dev\|/etc/pve\|subvol-')

if [ "${#ST_N[@]}" -gt 1 ]; then
    echo ""
    hdr "Storage"
    echo ""
    for ((i=0; i<${#ST_N[@]}; i++)); do
        row "${ST_N[$i]}:" "${ST_P[$i]}% of ${ST_T[$i]}" "85" "Usage:" "${ST_U[$i]} / ${ST_T[$i]}"
    done
fi

# Aliases
echo ""
hdr "Aliases"
echo ""
echo -e "  ${GREEN}dc${R}${OVERLAY}·${R}${GREEN}dcu${R}${OVERLAY}·${R}${GREEN}dcd${R}${OVERLAY}·${R}${GREEN}dcr${R}${OVERLAY}·${R}${GREEN}dcl${R}${OVERLAY}·${R}${GREEN}dcp${R}  ${OVERLAY}compose up/down/restart/logs/pull${R}"
echo -e "  ${GREEN}dps${R}${OVERLAY}·${R}${GREEN}dprune${R}${OVERLAY}·${R}${GREEN}dbackup${R}${OVERLAY}·${R}${GREEN}drestore${R}  ${OVERLAY}ps/prune/backup/restore${R}"
echo -e "  ${GREEN}cdd${R} ${OVERLAY}<stack>${R}          ${OVERLAY}cd /docker/<stack>${R}"
echo -e "  ${GREEN}update${R}${OVERLAY}·${R}${GREEN}banner${R}${OVERLAY}·${R}${GREEN}clh${R}${OVERLAY}·${R}${GREEN}tidy${R}${OVERLAY}·${R}${GREEN}apt-repair${R}  ${OVERLAY}system maintenance${R}"

# Last login
LAST=$(last -1 -R "$USER" 2>/dev/null | head -1)
if [ -n "$LAST" ] && ! echo "$LAST" | grep -q "^$"; then
    LOGIN_TIME=$(echo "$LAST" | awk '{for(i=3;i<=NF;i++) printf "%s ", $i}' | xargs)
    echo ""
    echo -e " ${OVERLAY}Last login: ${LOGIN_TIME}${R}"
fi
echo ""
{% endraw %}
