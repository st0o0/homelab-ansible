# Managed by Ansible -- do not edit manually.
HOST_HOSTNAME={{ node_stack_hostname }}
TZ={{ node_stack_tz }}
{% if node_stack_alloy_enabled %}

# Alloy
SCRAPE_INTERVAL={{ node_stack_scrape_interval }}
REMOTE_WRITE_URL=http://{{ node_stack_obs_host }}:8428/api/v1/write
LOGS_PUSH_URL=http://{{ node_stack_obs_host }}:9428/insert/loki/api/v1/push
{% endif %}
{% if node_stack_hawser_enabled %}

# Dockhand
DOCKHAND_SERVER_URL={{ node_stack_dockhand_url }}
DOCKHAND_TOKEN={{ node_stack_dockhand_token }}
AGENT_NAME={{ node_stack_hostname }}
HEARTBEAT_INTERVAL={{ node_stack_dockhand_heartbeat }}
{% endif %}
{% if node_stack_ups_enabled %}

# NUT UPS
NUT_DRIVER={{ node_stack_ups_driver }}
NUT_NAME={{ node_stack_ups_name }}
NUT_PORT={{ node_stack_ups_port }}
NUT_POLLINTERVAL={{ node_stack_ups_pollinterval }}
NUT_API_USER={{ node_stack_ups_api_user }}
NUT_API_PASSWORD={{ node_stack_ups_api_password }}
{% endif %}
{% if node_stack_backrest_enabled %}

# Backrest
BACKREST_PORT={{ node_stack_backrest_port }}
{% endif %}
{% if node_stack_bifrost_enabled %}

# Bifrost
BIFROST_PRIVATE_KEY={{ node_stack_bifrost_private_key }}
BIFROST_ADDRESS={{ node_stack_bifrost_address }}
BIFROST_LISTEN_PORT={{ node_stack_bifrost_listen_port }}
BIFROST_MTU={{ node_stack_bifrost_mtu }}
BIFROST_PEER_PUBLIC_KEY={{ node_stack_bifrost_peer_public_key }}
BIFROST_PEER_ENDPOINT={{ node_stack_bifrost_peer_endpoint }}
BIFROST_PEER_ALLOWED_IPS={{ node_stack_bifrost_peer_allowed_ips }}
BIFROST_PEER_KEEPALIVE={{ node_stack_bifrost_peer_keepalive }}
BIFROST_PEER_PRESHARED_KEY={{ node_stack_bifrost_peer_preshared_key }}
{% endif %}
