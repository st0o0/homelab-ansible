# Managed by Ansible -- do not edit manually.
COMPOSE_FILE={{ (['compose.yml']
  + (['compose.override.bifrost.yml'] if agent_bifrost else []))
  | join(':') }}
TZ={{ agent_tz }}

# Image
KOMODO_IMAGE_TAG={{ agent_image_tag }}

# Periphery
PERIPHERY_CORE_ADDRESS={{ agent_core_address }}
PERIPHERY_CONNECT_AS={{ agent_connect_as }}
PERIPHERY_ONBOARDING_KEY={{ agent_onboarding_key }}
PERIPHERY_ROOT_DIRECTORY={{ agent_root_directory }}
PERIPHERY_INCLUDE_DISK_MOUNTS={{ agent_include_disk_mounts }}
PERIPHERY_DISABLE_TERMINALS={{ agent_disable_terminals | lower }}
PERIPHERY_DISABLE_CONTAINER_TERMINALS={{ agent_disable_container_terminals | lower }}
