# Managed by Ansible -- do not edit manually.
COMPOSE_FILE={{ (['compose.yml']
  + (['compose.override.bifrost.yml'] if komodo_periphery_bifrost else []))
  | join(':') }}
TZ={{ komodo_periphery_tz }}

# Image
KOMODO_IMAGE_TAG={{ komodo_periphery_image_tag }}

# Periphery
PERIPHERY_CORE_ADDRESS={{ komodo_periphery_core_address }}
PERIPHERY_CONNECT_AS={{ komodo_periphery_connect_as }}
PERIPHERY_ONBOARDING_KEY={{ komodo_periphery_onboarding_key }}
PERIPHERY_ROOT_DIRECTORY={{ komodo_periphery_root_directory }}
PERIPHERY_INCLUDE_DISK_MOUNTS={{ komodo_periphery_include_disk_mounts }}
PERIPHERY_DISABLE_TERMINALS={{ komodo_periphery_disable_terminals | lower }}
PERIPHERY_DISABLE_CONTAINER_TERMINALS={{ komodo_periphery_disable_container_terminals | lower }}
